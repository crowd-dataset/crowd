{
  "data": ["/data", "/data-2"],
  "videos": ["/videos", "/videos-2"],
  "mapping": "mapping.csv",
  "machine_name": "dashcaminator",
  "tracking_mode": true,
  "always_analyse": false,
  "delete_youtube_video": true,
  "save_annotated_video": false,
  "delete_runs_files": true,
  "external_ssd": false,
  "min_max_videos": 0,
  "track_buffer_sec": 2,
  "bbox_tracker": "bbox_custom_tracker.yaml",
  "client": "WEB",
  "tracking_model": "yolo11x.pt",
  "countries_analyse": [],
  "vehicles_analyse": [],
  "min_confidence": 0.7,
  "update_pop_country": false,
  "update_gini_value": false,
  "update_package": true,
  "need_authentication": true,
  "font_family": "Open Sans, verdana, arial, sans-serif",
  "font_size": 18,
  "plotly_template": "plotly_white",
  "logger_level": "info",
  "sleep_sec": 1800,
  "git_pull": true,
  "email_send": false,
  "email_sender": "",
  "email_recipients": [],
  "ftp_server": "https://files.mobility-squad.com/",
  "snellius_mode": false,
  "snellius_shard_mode": "segment",
  "snellius_tmp_root": "$TMPDIR",
  "max_workers": 1,
  "download_workers": 2,
  "max_active_segments_per_video": 1,
  "runs_root": "runs_mt",
  "display_frame_tracking": false,
  "display_frame_segmentation": false,
  "save_annoted_img": false,
  "save_tracked_img": false,
  "delete_labels": true,
  "delete_frames": true
}
